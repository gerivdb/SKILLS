#!/bin/sh
# commit-msg — guard T46
# Refuse :
#  - un message de commit de moins de 10 caractères
#  - un message contenant le caractère '<' (placeholder non remplacé)
msgfile="$1"
msg=$(cat "$msgfile" | tr -d '\r\n')
msg_len=$(printf '%s' "$msg" | wc -c)
if [ "$msg_len" -lt 10 ]; then
  echo "COMMIT-MSG REJECT: message de commit trop court (< 10 caracteres): '$msg'"
  exit 1
fi
case "$msg" in
  *'<'*)
    echo "COMMIT-MSG REJECT: placeholder '<' detecte dans le message de commit"
    exit 1 ;;
esac
exit 0
