#!/bin/sh
# pre-commit — guards T40/T41/T42/T43
# Refuse tout commit comportant :
#  - un fichier piste > 5 Mo (sauf pointeur Git LFS)
#  - un fichier dans node_modules/, .venv/, __pycache__/
#  - un fichier junk OS (.DS_Store, Thumbs.db, desktop.ini)
#  - un potentiel secret (ghp_, gho_, AKIA, sk-..., xox[b/p]-, -----BEGIN ... PRIVATE KEY)
reject=0

# Récupère la liste des fichiers stagés (bash word splitting gère les retours-ligne)
staged_files=$(git diff --cached --name-only)

for file in $staged_files; do
  [ -z "$file" ] && continue

  # T41 : fichier > 5 Mo (sauf pointeur LFS)
  if [ -e "$file" ]; then
    sz=$(python -c "import os; print(os.path.getsize('$file'))" 2>/dev/null || echo 0)
    if [ "$sz" -gt 5242880 ] 2>/dev/null; then
      :
    else
      sz_ok=1
    fi
    if [ -z "$sz_ok" ]; then
      is_lfs=$(python -c "
try:
    with open('$file', 'rb') as f:
        head = f.read(160)
        print('LFS' if b'version https://git-lfs' in head else 'NOT_LFS')
except Exception:
    print('ERROR')
" 2>/dev/null)
      if [ "$is_lfs" != "LFS" ]; then
        echo "PRE-COMMIT REJECT: $file (> 5 Mo, utiliser Git LFS)"
        reject=1
      fi
    fi
    unset sz_ok
  fi

  # T42 : vendor
  case "$file" in
    */node_modules/*|*/.venv/*|*/__pycache__/*)
      echo "PRE-COMMIT REJECT: $file (repertoire vendor interdit)"
      reject=1 ;;
  esac

  # T43 : junk OS
  bn=$(basename "$file" 2>/dev/null || echo "$file")
  case "$bn" in
    .DS_Store|Thumbs.db|desktop.ini)
      echo "PRE-COMMIT REJECT: $file (junk OS piste)"
      reject=1 ;;
  esac

  # T40 : secrets (fichiers texte uniquement)
  # Exclure le hook lui-même (contient les patterns de détection)
  if [ "$file" = ".githooks/pre-commit" ]; then
    :
  elif [ -f "$file" ]; then
    secret=$(python -c "
import re, sys
try:
    with open('$file', 'r', encoding='utf-8', errors='ignore') as f:
        content = f.read()
    patterns = [r'ghp_', r'gho_', r'AKIA', r'\bsk-[A-Za-z0-9]{20,}', r'xox[bp]-', r'-----BEGIN.*PRIVATE']
    for p in patterns:
        if re.search(p, content):
            print('SECRET')
            sys.exit(0)
except Exception:
    pass
print('OK')
" 2>/dev/null)
    if [ "$secret" = "SECRET" ]; then
      echo "PRE-COMMIT REJECT: $file (potentiel secret détecté)"
      reject=1
    fi
  fi
done

# T44 : Skill/Citizen préalable — interdiction des scripts inline/processus ad hoc
# quand un Skill ou Citizen existant couvre le besoin.
if command -v python >/dev/null 2>&1; then
    python "D:\DO\WEB\TOOLS\L0-CANON\unified-design\scripts\verify-skill-citizen-prealable.py" \
        --skills-index "skills-index.json" \
        --citizens "D:\DO\WEB\TOOLS\L3-CITIZENS\CITIZENS\CITIZENS.yaml" \
        --staged-files $staged_files 2>/dev/null || true
fi

# T45 : Submodule Guardian — détection sous-modules tierce (non-gerivdb)
# Interdit de committer un sous-module tierce sans fork gerivdb/* préalable.
if command -v python >/dev/null 2>&1; then
    while IFS= read -r sm; do
        [ -z "$sm" ] && continue
        # Format: <status><SHA> <path>
        smPath=${sm#* }
        [ -z "$smPath" ] && continue
        smRemote=$(git -C "$smPath" remote -v 2>/dev/null || true)
        case "$smRemote" in
          *gerivdb/*) ;;
          *)
            echo "PRE-COMMIT REJECT: $smPath (sous-module tierce, remote non-gerivdb — modification interdite sans fork gerivdb/*)"
            reject=1 ;;
        esac
    done < <(git submodule status 2>/dev/null || true)
fi

# T46 : Git History Guardian — détection commits étrangers dans la plage push
upstream=$(git rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null || true)
if [ -n "$upstream" ]; then
    if command -v python >/dev/null 2>&1; then
        foreign=$(git log --format="%H%x09%ae%x09%s" "@{u}..HEAD" 2>/dev/null | python -c "
import sys
for line in sys.stdin:
    parts = line.strip().split('\t')
    if len(parts) < 3: continue
    sha, author, message = parts[0], parts[1], parts[2]
    is_foreign = False
    if 'gerivdb@users.noreply.github.com' not in author:
        is_foreign = True
    foreign_repos = ['NEXUS','CTULU','GATEWAY','SKILLS','PRIMUS','GOVERNANCE','ECOYSTEM','BRAIN','FLUENCE','RACINES','GERIBOOKING','BANK-BUSTER','CANDIDATOR','DATA-MINER','strix','TQL','DevTools','email-sender','WAZAA','COMET','ECIT','ECO','ecos','JOURNALISTE','LUKAS','ONTOLOGY_MC','DOC-UNIV','optimiser','comparateur','FRUSTRATION','JP-PETIT']
    for r in foreign_repos:
        if r in message:
            is_foreign = True
            break
    if is_foreign:
        print(f'PRE-COMMIT REJECT: {sha} :: auteur={author} :: message={message}')
" 2>/dev/null)
        if [ -n "$foreign" ]; then
            echo "$foreign"
            reject=1
        fi
    fi
fi

exit $reject
