#!/bin/sh
# pre-push — guards T44/T45
# $1 = remote, $2 = url
# Refuse si la branche locale est divergee du remote-tracking (risque d'ecrasement)
# et interdit --force pur (politique : seul --force-with-lease est tolere, voir HOOKS.md).
remote="$1"; url="$2"
reject=0
while read local_ref local_sha remote_ref remote_sha; do
  [ -z "$local_ref" ] && continue
  case "$local_ref" in
    refs/heads/*) ;;
    *) continue ;;
  esac
  branch=${local_ref#refs/heads/}
  # T44 : verifier que la branche locale n'est pas derriere le remote-tracking
  remote_tracking="refs/remotes/$remote/$branch"
  remote_sha_local=$(git rev-parse --verify "$remote_tracking" 2>/dev/null || echo "")
  if [ -n "$remote_sha_local" ] && [ -n "$local_sha" ] \
     && [ "$local_sha" != "0000000000000000000000000000000000000000" ]; then
    if ! git merge-base --is-ancestor "$remote_sha_local" "$local_sha" 2>/dev/null; then
      echo "PRE-PUSH REJECT: $branch est divergé du remote $remote (rebase/pull d'abord avant push)"
      reject=1
    fi
  fi
done
# T45 : --force pur interdit (--force-with-lease uniquement).
# Le hook pre-push ne reçoit pas les options de ligne de commande ; l'interdiction
# de --force pur est appliquée par politique et par le guard pre-push wrapper (voir HOOKS.md).
exit $reject
