#!/usr/bin/env python3
"""mox-convert — Convert PRD to PRD_MOC."""

import sys
import io
from pathlib import Path

# Fix Windows console encoding
if sys.platform == "win32":
    sys.stdout = io.TextIOWrapper(sys.stdout.buffer, encoding="utf-8", errors="replace")
    sys.stderr = io.TextIOWrapper(sys.stderr.buffer, encoding="utf-8", errors="replace")

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
from mox_validator import MOXValidator


def main():
    if len(sys.argv) < 2:
        print("Usage: mox-convert <document_path> [output_path]")
        sys.exit(1)
    
    document_path = Path(sys.argv[1])
    output_path = Path(sys.argv[2]) if len(sys.argv) > 2 else None
    
    if not document_path.exists():
        print(f"[ERROR] Document not found: {document_path}")
        sys.exit(1)
    
    mox = MOXValidator()
    success, message = mox.convert_prd_to_moc(document_path, output_path)
    
    if success:
        print(f"[MOX] Conversion successful: {message}")
        sys.exit(0)
    else:
        print(f"[MOX] Conversion failed: {message}")
        sys.exit(1)


if __name__ == "__main__":
    main()
