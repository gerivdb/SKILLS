#!/usr/bin/env python3
"""mox-validate — Validate a document with MOX."""

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
from mox_validator import MOXValidator


def main():
    if len(sys.argv) < 2:
        print("Usage: mox-validate <document_path> [--strict]")
        sys.exit(1)
    
    document_path = Path(sys.argv[1])
    strict = "--strict" in sys.argv
    
    if not document_path.exists():
        print(f"[MOX] ERROR: Document not found: {document_path}")
        sys.exit(1)
    
    mox = MOXValidator()
    result = mox.validate(document_path, strict=strict)
    
    print(result.summary())
    
    if result.valid:
        print("[MOX] Validation PASSED")
        sys.exit(0)
    else:
        print("[MOX] Validation FAILED")
        sys.exit(1)


if __name__ == "__main__":
    main()
